# DPMtF-LightWorker — environment-variable names only.
# Copy this file to .env and fill the values locally; never commit .env.
# No secrets are stored here. Machine-specific paths live in the worker's
# Machine Profile, not in the repository.

# Worker identity (validated against envelope.worker_id)
LIGHTWORKER_ID=

# Comma-separated schema versions accepted by the envelope validator.
LIGHTWORKER_SUPPORTED_SCHEMA_VERSIONS=1

# Comma-separated client adapters accepted by the envelope validator.
LIGHTWORKER_SUPPORTED_CLIENTS=opencode

# Filesystem root for repository mirrors, disposable worktrees and
# deliverable paths. The validator rejects any path that escapes this root.
LIGHTWORKER_REPOSITORY_ROOT=
